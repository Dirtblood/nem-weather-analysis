table 'BOM Bris Rainfall'
	lineageTag: 1c2919c9-f1a1-4a46-ab11-5eee8b2bc746

	measure 'Total Bris Rainfall' = SUM('BOM Bris Rainfall'[Rainfall amount millimetres])
		lineageTag: 3189cc07-cbc1-4656-ac3f-fd8aaacd54c6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Daily BNE Rainfall' =
			
			AVERAGE('BOM Bris Rainfall'[Rainfall amount millimetres])
		lineageTag: 2b6f578e-bce7-4234-aedc-011bf6566079

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total BNE Rainy Days' =
			
			CALCULATE(
			    COUNTROWS('BOM Bris Rainfall'),
			    'BOM Bris Rainfall'[Rainfall amount millimetres] > 0
			)
		formatString: 0
		lineageTag: 9136094b-0c90-4c44-919b-27eab7ce9cb7

	measure '% Rainy Days' =
			
			DIVIDE(
			    [Total BNE Rainy Days],
			    COUNTROWS('BOM Bris Rainfall')
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f9106ee8-e7fe-4c35-9e11-3d0097f19c28

	measure 'Average RRP on Rainy Days' =
			
			CALCULATE(
			    [Average RRP],
			    'BOM Bris Rainfall'[Rainfall amount millimetres] > 0
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 7cf81871-c73c-401f-99db-eec939d505a1

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Average RRP on Dry Days' =
			
			CALCULATE(
			    [Average RRP],
			    'BOM Bris Rainfall'[Rainfall amount millimetres] = 0
			    || ISBLANK('BOM Bris Rainfall'[Rainfall amount millimetres])
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 6bb70ceb-fcf4-4af9-8998-2500f4407638

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Demand on Dry Days' =
			
			CALCULATE(
			    [Average Demand],
			    'BOM Bris Rainfall'[Rainfall amount millimetres] = 0
			    || ISBLANK('BOM Bris Rainfall'[Rainfall amount millimetres])
			)
		lineageTag: 28498928-2739-4d5a-85ec-55ba1b7369d4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Demand on Rainy Days' =
			
			CALCULATE([Average Demand], 'BOM Bris Rainfall'[Rainfall amount millimetres] > 0)
		lineageTag: 2e122be8-40ee-4d8c-8894-091b31159133

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Demand Difference (Rainy - Dry)' =
			
			[Avg Demand on Rainy Days] - [Avg Demand on Dry Days]
		lineageTag: 0df0d634-ce05-4abd-a028-68498dd97d83

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'RRP Difference (Rainy - Dry)' =
			
			[Average RRP on Rainy Days] - [Average RRP on Dry Days]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 29097cfa-1cee-4a9c-81eb-7a34c0efefe0

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

