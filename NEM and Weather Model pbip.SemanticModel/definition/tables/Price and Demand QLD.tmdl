table 'Price and Demand QLD'
	lineageTag: eafcf10f-9b13-40b1-b07c-051a5244d69a

	measure 'Total RRP' = SUM('Price and Demand QLD'[RRP])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: e458f93e-fd96-400a-8141-b0c2532fc7c4

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total States' = DISTINCTCOUNT('Price and Demand QLD'[State])
		formatString: 0
		lineageTag: a0bf2690-8639-4f5d-ac30-c1150fd31b6b

	measure 'Total Demand QLD' = SUM('Price and Demand QLD'[Total Demand])
		lineageTag: 80c046b5-3a16-4c37-bef7-fe8b6707dddc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average RRP' = AVERAGE('Price and Demand QLD'[RRP])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 9251032f-ef35-4ef8-bcbf-dbf2ddfd53aa

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Peak Demand' = MAX('Price and Demand QLD'[Total Demand])
		lineageTag: 839a3e5d-9889-4ad5-9e55-af4e009f0692

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Volume Weighted Average Price' =
			
			DIVIDE(
			    SUMX('Price and Demand QLD', [RRP] * [Total Demand]),
			    [Total Demand QLD]
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 1131c8d8-da04-4e32-92ff-253e6a14a069

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Price (RRP) Volatility' = STDEV.P('Price and Demand QLD'[RRP])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 727f149b-1014-4a0e-8771-f0f4ce2d1a89

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'RRP CV' = DIVIDE([Price (RRP) Volatility], [Average RRP])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 22801cb1-47c9-4ec4-af2b-80a1dabc0943

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Load Factor' =
			
			DIVIDE(
			    [Total Demand QLD],
			    [Peak Demand] * COUNTROWS('Price and Demand QLD')
			)
		lineageTag: 4842735c-f15c-4221-9bd5-d5e4c3bcce6f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Negative Prices' =
			
			DIVIDE(
			    CALCULATE(COUNTROWS('Price and Demand QLD'), 'Price and Demand QLD'[RRP] < 0),
			    COUNTROWS('Price and Demand QLD')
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4d88b140-cb7f-4ab2-90c5-11a05cd68f77

	measure VWAP =
			
			DIVIDE(
			    SUMX('Price and Demand QLD', [RRP] * [Total Demand]),
			    [Total Demand QLD])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 3422e007-7d67-46f2-a369-298f5371e8e7

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'High Price Intervals' =
			
			CALCULATE(
			    COUNTROWS('Price and Demand QLD'),
			    'Price and Demand QLD'[RRP] > 300
			)
		formatString: 0
		lineageTag: bf995398-7711-4538-be89-8db93348d8a5

	measure '% High Price Intervals' =
			
			DIVIDE([High Price Intervals], COUNTROWS('Price and Demand QLD'))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: dce78a3d-1421-4ce2-ad61-a1c8cfad4973

	measure 'Extreme Price Intervals' =
			
			CALCULATE(
			    COUNTROWS('Price and Demand QLD'),
			    'Price and Demand QLD'[RRP] > 1000
			)
		formatString: 0
		lineageTag: f3b0555d-7ff4-4c1f-8ea0-9c8673304645

	measure 'Negative Price Intervals' =
			
			CALCULATE(
			    COUNTROWS('Price and Demand QLD'),
			    'Price and Demand QLD'[RRP] < 0
			)
		formatString: 0
		lineageTag: 760b90fb-974c-4498-a657-48d5a208efb9

	measure '% Negative Price Intervals' =
			
			DIVIDE([Negative Price Intervals], COUNTROWS('Price and Demand QLD'))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ca09242c-fda9-45da-966c-8ebea75183a8

	measure 'Min Demand' = MIN('Price and Demand QLD'[Total Demand])
		lineageTag: a3009a3e-272a-4f79-a57b-d649c5e423d0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Demand Range' = [Peak Demand] - [Min Demand]
		lineageTag: 9711ad10-bacd-44f6-8d2b-8d92119908e6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Demand' = AVERAGE('Price and Demand QLD'[Total Demand])
		lineageTag: 688d0f76-5c3f-426c-99e7-1f0f98f02308

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Peak to Average Ratio' = DIVIDE([Peak Demand], [Average Demand])
		lineageTag: 821816d7-f6f0-4e47-bed0-61efafe5758d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'High Price Volume' =
			
			CALCULATE(
			    [Total Demand QLD],
			    'Price and Demand QLD'[RRP] > 300)
		lineageTag: 98c1aa70-b9cd-4ef9-b0a2-70b35d4e6ab8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Demand in High Price' =
			
			DIVIDE([High Price Volume], [Total Demand QLD])
		lineageTag: e792a4d9-12d0-4314-9b57-8a054dd95fb3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'High Price Value' =
			
			CALCULATE(
			    SUMX('Price and Demand QLD', [RRP] * [Total Demand]),
			    'Price and Demand QLD'[RRP] > 300
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 24d268a8-4750-4794-8b72-2a2240d3dd46

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Average RRP Daytime' =
			
			CALCULATE(
			    [Average RRP],
			    'Price and Demand QLD'[Hour] >= 10 &&
			    'Price and Demand QLD'[Hour] <= 15
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: fbd5bf91-a64b-4cce-9e7e-bf4c0319e697

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Average RRP Evening Peak' =
			
			CALCULATE(
			    [Average RRP],
			    'Price and Demand QLD'[Hour] >= 17 &&
			    'Price and Demand QLD'[Hour] <= 20
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: baa90252-685b-4c12-bc8c-2cee1242c435

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Max RRP' = MAX('Price and Demand QLD'[RRP])
