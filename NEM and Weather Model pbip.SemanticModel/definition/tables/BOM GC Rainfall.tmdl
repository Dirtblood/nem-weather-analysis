table 'BOM GC Rainfall'
	lineageTag: 063ece1e-c06f-49b4-a968-27a19dd5f17a

	measure 'Total GC Rainfall' = SUM('BOM GC Rainfall'[Rainfall amount millimetres])
		lineageTag: 5facbc45-09b1-4f81-a1a3-fad076399fd6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Daily Rainfall GC' =
			
			AVERAGEX(
			    VALUES(Dim_Date[FullDate]),
			    [Total GC Rainfall]
			)
		lineageTag: 6ad40774-2fbf-44e9-ac04-6b423f013b9c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total GC Rainy Days' =
			
			CALCULATE(
			    COUNTROWS('BOM GC Rainfall'),
			    'BOM GC Rainfall'[Rainfall amount millimetres] > 0
			)
		formatString: 0
		lineageTag: 2c7ec164-7886-4469-aa94-a3b8ffd9bafa

	measure '% Rainy Days GC' =
			
			DIVIDE(
			    [Total GC Rainy Days],
			    COUNTROWS(Dim_Date)
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d88132b9-1e4b-4321-aa36-8cdde566ba69

	measure 'Average RRP on Rainy Days GC' =
			
			CALCULATE(
			    [Average RRP],
			    FILTER(Dim_Date, [Total GC Rainfall] > 0)
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: c49a8574-b588-4e44-9531-e2c64b2fb76b

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Average RRP on Dry Days GC' =
			
			CALCULATE(
			    [Average RRP],
			    FILTER(Dim_Date, [Total GC Rainfall] = 0 || ISBLANK([Total GC Rainfall]))
			)
		lineageTag: 735fd6c6-604f-4e99-921a-b3478d9c7ce5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'RRP Difference BNE VS GC (Rainy - Dry)' =
			
			[Average RRP on Rainy Days GC] - [Average RRP on Dry Days GC]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: f11a773b-2e56-473c-9dd3-42a3425100ae

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'RRP Difference GC (Rainy - Dry)' =
			
			[Average RRP on Rainy Days GC] - [Average RRP on Dry Days GC]
		lineageTag: 4fbede76-fcb8-4fce-b9e8-9356a171101e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Demand on Rainy Days GC' =
			
			CALCULATE(
			    [Average Demand],
			    FILTER(Dim_Date, [Total GC Rainfall] > 0)
			)
		lineageTag: 044dff39-9666-40d7-b44f-c5cc0110894d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Demand on Dry Days GC' =
			
			CALCULATE(
			    [Average Demand],
			    FILTER(Dim_Date, [Total GC Rainfall] = 0 || ISBLANK([Total GC Rainfall]))
			)
		lineageTag: 58dc8097-5534-479a-814d-0adf106821ea

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Daily GC Rainfall' = AVERAGE('BOM GC Rainfall'[Rainfall amount millimetres])
		lineageTag: dcabb186-6be7-4c55-bea8-69b0e5f4bb79

		annotation PBI_FormatHint = {"isGeneralNumber":true}

