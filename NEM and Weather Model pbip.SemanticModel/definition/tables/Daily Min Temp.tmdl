table 'Daily Min Temp'
	lineageTag: 0a492ef8-3ac5-4914-a66f-69ead39cbeb6

	measure 'Average Min Temp' = AVERAGE('Daily Min Temp'[Min Temp Degrees])
		lineageTag: 59178232-cf57-4034-995e-0187dfa57435

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Temp Range' =
			
			[Average Max Temp] - [Average Min Temp]
		lineageTag: 273cf8be-a69c-4ff6-84f2-397a2e572c79

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Temp (Mid point)' =
			
			DIVIDE([Average Max Temp] + [Average Min Temp], 2)
		lineageTag: b4526fc6-3332-407a-a730-cb46178e710f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cold Days' =
			
			CALCULATE(
			    COUNTROWS('Daily Min Temp'),
			    'Daily Min Temp'[Min Temp Degrees] <= 10)
		formatString: 0
		lineageTag: 7ce32742-9255-4f96-a2c4-cde513f83b72

	measure 'Min Temperature' =
			
			MIN('Daily Min Temp'[Min Temp Degrees])
		lineageTag: 39d3e693-d581-459e-b941-7a3ad509c3f7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

