table 'BOM Daily Max Temp'
	lineageTag: 00b8bbe9-00de-4f17-aea4-a1c45baca43d

	measure 'Average Max Temp' = AVERAGE('BOM Daily Max Temp'[Max Temp Degrees])
		lineageTag: e84773c3-5e5f-4c64-8182-7f1c3db1951b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Hot Days (above 30 degrees)' =
			
			CALCULATE(
			    COUNTROWS('BOM Daily Max Temp'),
			    'BOM Daily Max Temp'[Max Temp Degrees] >= 30
			)
		formatString: 0
		lineageTag: 11605cac-09ff-4edb-84aa-992d204417f2

	measure 'Max Daily Temp' = SUM('BOM Daily Max Temp'[Max Temp Degrees])
		lineageTag: 0bd242f8-f634-44b9-b472-f7f3dc4d474e

